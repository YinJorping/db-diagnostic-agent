# ============================================================
# Docker Compose 环境变量模板
# 复制此文件为 .env 并填入真实值
#   cp .env.example .env
# ============================================================

# ---- LLM API Key（必填）----
DEEPSEEK_API_KEY=your-deepseek-api-key

# ---- PostgreSQL ----
POSTGRES_DB=dbdiagnostic
POSTGRES_USER=diagnostic
POSTGRES_PASSWORD=change-me

# ---- Redis ----
REDIS_PASSWORD=

# ---- LLM Provider ----
# deepseek | openai
LLM_PROVIDER=deepseek
